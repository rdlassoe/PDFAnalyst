# Copie este archivo a .env y reemplace los valores. NUNCA suba .env al repositorio.
POSTGRES_USER=pdfanalyst
POSTGRES_DB=pdfanalyst
# Genere una contraseña larga y aleatoria, p. ej.: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Embeddings (locales por defecto) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Generación (local por defecto) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# Por defecto: Ollama instalado en el host (Docker Desktop lo expone como host.docker.internal).
# Alternativa autocontenida: `docker compose --profile ollama up -d` y OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- OCR ---
OCR_ENABLED=true
OCR_LANGS=spa+eng

# --- Web ---
CORS_ORIGINS=http://localhost:3000

# Puerto del host para PostgreSQL (solo loopback). Útil si 5432 está ocupado.
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Opcional: reutilizar el almacén de modelos de un Ollama del host (solo lectura). Si se omite, se usa un volumen propio
# y los modelos se descargan con: docker compose exec ollama ollama pull qwen3:8b
#OLLAMA_MODELS_SOURCE=C:/Users/<usuario>/.ollama/models
#OLLAMA_MODELS_MODE=:ro

# ============================================================================================
# PROVEEDOR DE GENERACIÓN (LLM) del ENTORNO. Es el predeterminado hasta que se elija otro en la interfaz (Ajustes),
# donde también se pueden añadir Groq/Gemini/OpenAI con su clave sin tocar este archivo. Aquí, elija UNO. Tras editar: docker compose up -d api   (recrea el contenedor)
# Los embeddings siempre son locales e independientes de este bloque.
# ============================================================================================
# --- A) Ollama local (por defecto): nada que cambiar aparte del modelo ---
#LLM_PROVIDER=ollama
#LLM_MODEL=qwen3:8b

# --- B) Groq (servicio externo; envía los fragmentos recuperados a Groq) ---
#LLM_PROVIDER=openai-compatible
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=<modelo de la consola de Groq, p. ej. llama-3.3-70b-versatile>
#LLM_API_KEY=<su clave de https://console.groq.com>
#LLM_ALLOW_EXTERNAL=true

# --- C) Google Gemini API (servicio externo; endpoint compatible con OpenAI) ---
#LLM_PROVIDER=openai-compatible
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=<modelo de Google AI Studio, p. ej. gemini-2.0-flash>
#LLM_API_KEY=<su clave de https://aistudio.google.com/apikey>
#LLM_ALLOW_EXTERNAL=true

# --- D) OpenAI (servicio externo) ---
#LLM_PROVIDER=openai-compatible
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=<modelo>
#LLM_API_KEY=<su clave>
#LLM_ALLOW_EXTERNAL=true

# --- E) Servidor local compatible (LM Studio, llama.cpp, vLLM): NO requiere LLM_ALLOW_EXTERNAL ---
#LLM_PROVIDER=openai-compatible
#LLM_BASE_URL=http://host.docker.internal:1234/v1
#LLM_MODEL=<nombre del modelo cargado>

# Clave maestra para cifrar las claves API guardadas desde Ajustes (opcional; si se omite se genera /data/secret.key).
#APP_SECRET_KEY=

# ============================================================================================
# PARÁMETROS AJUSTABLES (opcionales; se muestran los valores por defecto). Referencia: docs/OPERATIONS.md §10
# Tras editar: docker compose up -d api worker
# ============================================================================================
#EMBEDDING_ALLOW_EXTERNAL=false   # solo para un Ollama remoto del perfil «Entorno»; los proveedores de Ajustes tienen su propia casilla
#EMBEDDING_TIMEOUT_S=60
#MAX_UPLOAD_MB=100
#OCR_MIN_CHARS=30
#CHUNK_TARGET_CHARS=1200
#CHUNK_OVERLAP_CHARS=200
# Medios (imágenes). Referencia: docs/OPERATIONS.md §10
#MEDIA_MAX_IMAGE_MB=20            # tamaño máximo de una imagen subida
#MEDIA_MAX_PIXELS=40000000        # píxeles máximos (≈ 40 megapíxeles; protege de bombas de descompresión)
#MEDIA_THUMB_PX=320               # lado mayor de las miniaturas
#VISION_MAX_SIDE=1568             # las imágenes se reducen a este lado mayor antes de enviarlas al modelo de visión
#VISION_MAX_TOKENS=500            # longitud máxima de la descripción
#VISION_RETRIES=3                 # reintentos ante límites de tasa (429) del proveedor
# Figuras dentro de PDF (imágenes incrustadas y gráficos vectoriales): se leen con OCR, se describen con el modelo de visión y se vectorizan
#PDF_FIGURES_ENABLED=true          # false = ignorar las figuras (comportamiento anterior)
#PDF_FIGURES_MAX=60                # tope por documento (las más grandes primero): cada figura cuesta OCR, vector y, con modelo de visión, una descripción
#PDF_FIGURE_MIN_PX=100             # lado menor mínimo de una imagen incrustada
#PDF_FIGURE_MIN_AREA=0.02          # fracción mínima de la página que debe ocupar
#PDF_FIGURE_REPEAT_PAGES=3         # una imagen repetida en ≥ N páginas es fondo/logo y se ignora
#PDF_VECTOR_MIN_PATHS=40           # trazos vectoriales para considerar un gráfico
#PDF_VECTOR_MIN_AREA=0.15          # fracción mínima de la página del gráfico vectorial
#VISION_ANSWER_MAX_IMAGES=3        # figuras que se adjuntan al modelo de visión al responder
#RETRIEVAL_TOP_K=6
#RETRIEVAL_CANDIDATES=30
#RETRIEVAL_MIN_SIMILARITY=0.80   # por defecto (calibrado para e5); un perfil de embeddings de Ajustes puede llevar el suyo (EmbeddingGemma 2: 0.72)
#RETRIEVAL_MIN_SIMILARITY_MEDIA=0.65  # umbral para figuras/imágenes (otra escala que texto→texto); provisional, calibrar con sus PDF
#RETRIEVAL_FTS_MIN_COVERAGE=0.5
#RETRIEVAL_COMMON_TERM_RATIO=0.10
#HYBRID_ENABLED=true
#LLM_TEMPERATURE=0.1
#LLM_MAX_TOKENS=700
#LLM_TIMEOUT_S=180
#CONTEXT_MAX_TOKENS=3500

# ============================================================================================
# SERVICIO LOCAL DE EMBEDDINGS (contenedor `embedder`): EmbeddingGemma 2 solo texto, en CPU. Referencia: docs/OPERATIONS.md §13
# Se usa creando en Ajustes → Modelo de embeddings el perfil «EmbeddingGemma 2 (local…)». Descarga previa (≈1,5 GB, una vez):
#   docker compose run --rm embedder python -m app.embedding_server --download
# ============================================================================================
#EMBED_SERVER_MODEL=google/embeddinggemma-2
#EMBED_SERVER_TEXT_ONLY=true        # true = solo texto (≈270M parámetros, ≈1,9 GB de RAM medidos en fp32); false = carga también visión/audio (≈740M)
#EMBED_SERVER_DTYPE=float32         # float32 | bfloat16. NUNCA float16: EmbeddingGemma 2 no lo admite
#EMBED_SERVER_MAX_SEQ_LENGTH=2048   # tope de tokens por texto (acota la memoria); el modelo admite 8192
#EMBED_SERVER_PRELOAD=false         # true = cargar el modelo al arrancar (si no, en la primera petición)
#EMBED_SERVER_THREADS=0             # 0 = todos los hilos de PyTorch; limitar si el equipo se satura al indexar
#EMBED_SERVER_MEM_LIMIT=4608m       # tope de memoria del contenedor: solo texto ≈2,0 GB · +imagen ≈3,0 GB · +audio ≈3,7 GB (picos medidos en fp32)
#EMBED_SERVER_MEDIA_IDLE_S=300      # segundos sin usar medios tras los cuales el servicio vuelve a solo texto (libera memoria); 0 = nunca
#EMBED_SERVER_IMAGE_TOKENS=280      # presupuesto visual por imagen (70-1120): 280 ≈3,3 s · 140 ≈1,5 s · 70 ≈0,7 s por imagen en esta CPU
#EMBED_SERVER_VIDEO_TOKENS=140      # por fotograma de vídeo (≈1,5 s con 140, ≈0,7 s con 70)
#EMBED_SERVER_MEDIA_MAX_AUDIO_S=300 # ventana máxima de audio por vector (el modelo admite ≈327 s)

# Avanzado (valores por defecto; referencia completa en docs/OPERATIONS.md §10)
#EMBEDDING_BATCH_SIZE=32          # fragmentos por lote al embeber
#EMBEDDING_DEVICE=cpu             # «cuda» solo con una imagen con CUDA
#OCR_DPI=200                      # resolución a la que se renderiza una página para el OCR
#RRF_K=60                         # constante de la fusión por rango (RRF) vectorial + textual
#LLM_DISABLE_THINKING=true        # modelos con «razonamiento» (qwen3, deepseek-r1): responder directo
#JOB_MAX_ATTEMPTS=3               # reintentos de un trabajo con fallo transitorio
#JOB_STALE_MINUTES=30             # minutos tras los que un trabajo sin latido se da por huérfano
#WORKER_POLL_SECONDS=2            # cada cuántos segundos el worker mira la cola
